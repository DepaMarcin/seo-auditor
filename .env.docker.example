# Wzór zmiennych dla uruchomienia w Dockerze. Skopiuj do `.env` i uzupełnij.
#
#     cp .env.docker.example .env
#
# Plik `.env` jest poza repozytorium (`.gitignore`) i poza obrazem
# (`.dockerignore`) - compose podaje go kontenerom przez `env_file`.
#
# Wartości, których TU NIE MA, a które ustawia compose: POSTGRES_HOST,
# CELERY_BROKER_URL, CELERY_RESULT_BACKEND, REDIS_CACHE_URL,
# GA4_CLIENT_SECRETS_FILE. Wskazują na usługi wewnątrz sieci compose, więc nie
# ma ich po co powtarzać.

# ----------------------------------------------------------------------
# Django
# ----------------------------------------------------------------------
# Wygenerowanie:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# False na wdrożeniu. Przy True Django wyświetla ślady wyjątków razem z wartościami
# zmiennych - w tym kluczami API.
DJANGO_DEBUG=False

# Nazwy hostów, pod którymi aplikacja odpowiada, po przecinku.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Za odwrotnym proxy Django widzi adres kontenera, nie ten z paska przeglądarki -
# bez tej listy formularze odpadają na sprawdzeniu pochodzenia. Ze schematem.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Przekierowanie na HTTPS i ciasteczka wyłącznie po HTTPS. Włącz (True) dopiero,
# gdy przed aplikacją stanie proxy z certyfikatem. Sam `docker compose up` odpowiada
# po http: przy True przeglądarka dostaje 301 na https i pokazuje
# ERR_EMPTY_RESPONSE, a logowanie nie zapisuje sesji.
DJANGO_SECURE_SSL_REDIRECT=False

# ----------------------------------------------------------------------
# Baza danych
# ----------------------------------------------------------------------
# Obecność POSTGRES_DB przełącza aplikację z SQLite na PostgreSQL.
POSTGRES_DB=seo_auditor
POSTGRES_USER=seo_auditor
POSTGRES_PASSWORD=

# ----------------------------------------------------------------------
# Szyfrowanie zapisanych tokenów Google
# ----------------------------------------------------------------------
# Klucz Fernet. Jego UTRATA oznacza, że zapisanych tokenów nie da się odczytać
# i każdy użytkownik musi połączyć konto Google ponownie.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ----------------------------------------------------------------------
# Integracje zewnętrzne
# ----------------------------------------------------------------------
# Synteza multi-agentowa i rekomendacje RAG. Bez klucza raport powstaje z samych
# ustaleń, bez tekstu od modelu - aplikacja działa dalej.
OPENAI_API_KEY=

# PageSpeed Insights. Bez klucza limit zapytań jest znacznie niższy.
PAGESPEED_API_KEY=

# Senuto - historia widoczności w wyszukiwarce. Opcjonalne.
SENUTO_API_KEY=

# ----------------------------------------------------------------------
# Uruchomienie
# ----------------------------------------------------------------------
# Port na maszynie gospodarza. Wewnątrz kontenera aplikacja zawsze słucha na 8000.
WEB_PORT=8000
